# ===== 后端环境变量（复制为 .env 后修改）=====
# Django 密钥（生产必改，可用 python -c "import secrets; print(secrets.token_urlsafe(50))" 生成）
DJANGO_SECRET_KEY=change-me
# PDA 心跳上报 Token（X-Pda-Token 请求头）
PDA_HEARTBEAT_TOKEN=change-me-pda-token
# 首次启动创建的 admin 初始密码（登录后请立即修改）
INITIAL_ADMIN_PASSWORD=admin123
# AI 报告（Ollama）服务地址与模型，留空则降级为模板文案
OLLAMA_BASE=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
